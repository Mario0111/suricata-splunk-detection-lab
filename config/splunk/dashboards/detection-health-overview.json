      },
      "title": "Recent Alerts",
      "description": "Displays the most recent Suricata alerts with key event details, providing analysts with immediate context for investigation."
    }
  },
  "dataSources": {
    "ds_2KkRXTvd": {
      "type": "ds.search",
      "options": {
        "query": "index=suricata sourcetype=suricata:eve event_type=alert\n| stats count AS \"Total Alerts\""
      },
      "name": "Total Alerts"
    },
    "ds_BPyNtL6Q": {
      "type": "ds.search",
      "options": {
        "query": "index=suricata sourcetype=suricata:eve event_type=alert\n| stats dc(alert.signature) AS \"Unique Signatures\""
      },
      "name": "Unique Signatures"
    },
    "ds_0zZgPiv7": {
      "type": "ds.search",
      "options": {
        "query": "index=suricata sourcetype=suricata:eve event_type=alert\n| stats dc(src_ip) AS \"Source Hosts\""
      },
      "name": "Source Hosts"
    },
    "ds_uEI688Hp": {
      "type": "ds.search",
      "options": {
        "query": "index=suricata sourcetype=suricata:eve event_type=alert\n| stats min(alert.severity) AS \"Highest Severity\""
      },
      "name": "Highest Severity"
    },
    "ds_OVfkxTu4": {
      "type": "ds.search",
      "options": {
        "query": "index=suricata sourcetype=suricata:eve event_type=alert\n| timechart span=5m count AS Alerts"
      },
      "name": "Alerts over Time"
    },
    "ds_UAyWerd5": {
      "type": "ds.search",
      "options": {
        "query": "index=suricata sourcetype=suricata:eve event_type=alert\n| stats count by alert.signature\n| sort -count\n| head 10"
      },
      "name": "Top Alert Signatures"
    },
    "ds_LxDNWvTf": {
      "type": "ds.search",
      "options": {
        "query": "index=suricata sourcetype=suricata:eve event_type=alert\n| stats count AS Alerts by alert.severity\n| sort alert.severity"
      },
      "name": "Severity Distribution"
    },
    "ds_zfvLNXtb": {
      "type": "ds.search",
      "options": {
        "query": "index=suricata sourcetype=suricata:eve event_type=alert\n| stats count AS Alerts by src_ip\n| sort -Alerts\n| head 10"
      },
      "name": "Top Source IPs"
    },
    "ds_Qa8QoIFI": {
      "type": "ds.search",
      "options": {
        "query": "index=suricata sourcetype=suricata:eve event_type=alert\n| stats count AS Alerts by dest_ip\n| sort -Alerts\n| head 10"
      },
      "name": "Top Destination IPs"
    },
    "ds_RRAMrxAy": {
      "type": "ds.search",
      "options": {
        "query": "index=suricata sourcetype=suricata:eve event_type=alert\n| table _time alert.signature alert.severity src_ip dest_ip proto\n| sort -_time\n| head 20"
      },
      "name": "Recent Alerts"
    }
  },
  "defaults": {
    "dataSources": {
      "ds.search": {
        "options": {
          "queryParameters": {
            "latest": "$global_time.latest$",
            "earliest": "$global_time.earliest$"
          }
        }
      },
      "ds.spl2": {
        "options": {
          "queryParameters": {
            "latest": "$global_time.latest$",
            "earliest": "$global_time.earliest$"
          }
        }
      }
    },
    "visualizations": {
      "global": {
        "showProgressBar": true
      }
    }
  },
